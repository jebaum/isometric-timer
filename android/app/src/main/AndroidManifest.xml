<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Isometric">
        <!-- Portrait only: landscape leaves Pause and Skip below the fold on a
             phone-sized window, verified on device. Android 16 ignores this lock
             only on displays 600dp and wider, and the lock was confirmed to hold
             on the target phone (411dp) under a forced rotation. Both lint checks
             are suppressed here rather than project-wide, so the reasoning stays
             next to the decision and other uses of them still fail the build. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Isometric"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
